#!/usr/bin/python3
"""tailbell listener — stream remote Claude Code events to this workstation.

Runs on the machine with a screen. The remote hook only appends JSON lines to a
log file; this process tails that file over SSH and hands each line to
tailbell-show. Nothing is published to any third-party service, so there is no
quota and no account.

Why one listener covers a whole cluster: on Great Lakes /home is a single NFS
mount shared by all six login nodes and by the compute nodes, so every session
appends to the same file and tailing it from any one node sees all of them.
Verified in production: a listener attached to gl-login6 delivered an event
raised on gl-login4. GNU tail notices the file is on a remote filesystem and
polls instead of relying on inotify, which is what makes cross-node writes
visible at all.

Connections reuse whichever SSH master is already open (ControlMaster), so this
costs no extra authentication and never triggers a 2FA prompt. Consequence worth
knowing: events flow only while some master to the cluster is alive. A dead
connection means silence, not an error.

The shebang pins /usr/bin/python3 deliberately: a bare `python3` resolves to
whatever virtualenv happens to be active.
"""
import json
import os
import subprocess
import sys
import time

HOSTS = [h.strip() for h in
         os.environ.get("TAILBELL_HOSTS", "gl6,greatlakes").split(",") if h.strip()]
REMOTE_LOG = os.environ.get("TAILBELL_REMOTE_LOG", ".tailbell/events.log")
SHOW = os.environ.get(
    "TAILBELL_SHOW",
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "tailbell-show"))

# -n0 so a reconnect replays nothing stale; -F so rotation is survivable.
REMOTE_CMD = ("mkdir -p ~/.tailbell && touch ~/{log} && exec tail -n0 -F ~/{log}"
              .format(log=REMOTE_LOG))

SSH_OPTS = [
    "-o", "BatchMode=yes",          # fail fast rather than hang on a 2FA prompt
    "-o", "ServerAliveInterval=30",
    "-o", "ServerAliveCountMax=3",
]


def has_master(host):
    """True if an SSH master for host is already up, so we can attach for free."""
    try:
        r = subprocess.run(["ssh", "-O", "check", host], timeout=10,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    except Exception:
        return False


def pick_host():
    for h in HOSTS:
        if has_master(h):
            return h, True
    return (HOSTS[0] if HOSTS else "gl6"), False


def show(title, message, urgent=False, project=""):
    """Hand off to tailbell-show, which owns how the alert is drawn."""
    if os.access(SHOW, os.X_OK):
        argv = [SHOW, title, message, "urgent" if urgent else "", project or ""]
    else:
        argv = ["/usr/bin/osascript", "-e",
                'display notification %s with title %s sound name "Glass"'
                % (json.dumps(message), json.dumps(title))]
    # argv dispatch: the message stays data and can never be parsed as a command.
    try:
        subprocess.run(argv, timeout=15, check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def stream(host):
    proc = subprocess.Popen(["ssh"] + SSH_OPTS + [host, REMOTE_CMD],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            text=True, bufsize=1)
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        show(rec.get("title") or "Claude Code",
             rec.get("message") or "",
             urgent=(rec.get("priority") == "high"),
             project=rec.get("project") or "")
    proc.wait()


def main():
    backoff = 5
    while True:
        host, attached = pick_host()
        try:
            stream(host)
        except Exception:
            pass
        time.sleep(backoff)
        # Back off only while no master exists (editor disconnected), so we are
        # not spawning an ssh every few seconds all night.
        backoff = 5 if attached else min(backoff * 2, 120)


if __name__ == "__main__":
    sys.exit(main())
