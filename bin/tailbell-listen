#!/usr/bin/python3
"""tailbell listener — stream remote Claude Code events to this workstation.

Runs on the machine with a screen. The agent side appends JSON lines to
~/.tailbell/events.log on each host; this process tails every one of them over
SSH and hands each line to tailbell-show. Nothing is published to any third-party
service, so there is no quota and no account.

Hosts are DISCOVERED, not configured. Every SSH connection made with the
ControlMaster settings tailbell installs leaves a socket at ~/.ssh/cm-user@host-port,
so the set of sockets is exactly the set of machines you are connected to right
now. That matters because login nodes are not stable: Great Lakes has six and you
pick one per session, while Lighthouse and Armis2 assign you whichever they like.
A hardcoded host list would be wrong the moment you opened a different node.

Attaching to an existing master costs no authentication and never triggers a 2FA
prompt. The consequence is worth stating: events flow only while a connection to
that cluster is alive. A closed editor means silence, not an error.

Within one cluster a single stream is enough, because that cluster's login nodes
share one NFS $HOME — verified on Great Lakes, where a listener on gl-login6
delivered an event raised on gl-login4. Across clusters homes are separate, so
each connected cluster needs its own stream. Hence one thread per host.

The shebang pins /usr/bin/python3 deliberately: a bare `python3` resolves to
whatever virtualenv happens to be active.
"""
import json
import os
import re
import subprocess
import sys
import threading
import time

SSH_DIR = os.path.expanduser("~/.ssh")
REMOTE_LOG = os.environ.get("TAILBELL_REMOTE_LOG", ".tailbell/events.log")
SHOW = os.environ.get(
    "TAILBELL_SHOW",
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "tailbell-show"))
# Extra hosts to try even without a live master, comma separated. Normally empty:
# discovery is the point.
EXTRA = [h.strip() for h in os.environ.get("TAILBELL_HOSTS", "").split(",") if h.strip()]
# Only tail hosts whose name matches, if set. Use it if you keep SSH masters open
# to machines that have nothing to do with Claude Code.
ONLY = os.environ.get("TAILBELL_HOST_PATTERN", "")

RESCAN_SECONDS = 20

# Refuse to announce an event that already happened a while ago.
#
# `tail -n0 -F` starts at end of file, so history is never read on purpose — but
# tail follows BY NAME, and anything that replaces the file makes it reopen and
# read from the beginning. Log rotation used to do exactly that, and the result
# was every retained line delivered again as a fresh alert. The rotation is fixed;
# this is the guard that does not depend on the sender being fixed, because the
# sender is on a different machine and may be an older version.
#
# Generous, because the two clocks are not the same clock: the timestamp is
# stamped on the agent host and compared here.
MAX_AGE_SECONDS = int(os.environ.get("TAILBELL_MAX_AGE", "300"))

# `test -f` first: tailing a host where tailbell was never installed would create
# state there and stream nothing. Exiting immediately lets us mark it and back off.
REMOTE_CMD = ("test -f ~/{log} && exec tail -n0 -F ~/{log}".format(log=REMOTE_LOG))

SSH_OPTS = [
    "-o", "BatchMode=yes",          # fail fast rather than hang on a 2FA prompt
    "-o", "ServerAliveInterval=30",
    "-o", "ServerAliveCountMax=3",
]

# The port separator is NOT fixed. `ControlPath ...cm-%r@%h-%p` yields
# cm-user@host-22, but a config written with %h:%p yields cm-user@host:22 — and
# assuming the hyphen matched nothing at all, so the listener silently watched no
# hosts while every other check reported green. Accept either, and tolerate a
# path with no port at all.
_socket_re = re.compile(r"^cm-[^@]+@(?P<host>.+?)(?:[:-](?P<port>\d+))?$")


def hosts_from_ssh_config():
    """Host aliases from ~/.ssh/config, as a fallback.

    A ControlPath built from %C hashes the whole tuple, so the host is simply not
    recoverable from the filename. Aliases give us candidates to probe; only ones
    with a live master are actually used, so listing extras costs nothing.
    """
    out = set()
    try:
        with open(os.path.join(SSH_DIR, "config")) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) >= 2 and parts[0].lower() == "host":
                    for alias in parts[1:]:
                        if "*" not in alias and "?" not in alias:
                            out.add(alias)
    except OSError:
        pass
    return out


def discover_hosts():
    """Hosts we currently hold an SSH master to, from the ControlPath sockets."""
    found = set()
    try:
        names = os.listdir(SSH_DIR)
    except OSError:
        names = []
    for name in names:
        m = _socket_re.match(name)
        if m:
            found.add(m.group("host"))
    found |= hosts_from_ssh_config()
    found |= set(EXTRA)
    if ONLY:
        found = {h for h in found if re.search(ONLY, h)}
    return found


def master_alive(host):
    try:
        r = subprocess.run(["ssh", "-O", "check", host], timeout=10,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    except Exception:
        return False


# Two masters to the same cluster — say `greatlakes` and `gl-login6` — tail the
# same file, because that cluster's login nodes share one NFS $HOME. Without this
# every event would be announced once per connection.
_seen = {}
_seen_lock = threading.Lock()
DEDUPE_SECONDS = 120


def already_shown(rec):
    key = (rec.get("ts"), rec.get("title"), rec.get("message"))
    now = time.time()
    with _seen_lock:
        for k, t in list(_seen.items()):
            if now - t > DEDUPE_SECONDS:
                del _seen[k]
        if key in _seen:
            return True
        _seen[key] = now
    return False


def show(title, message, urgent=False, project="", app="", entrypoint="",
         kind=""):
    """Hand off to tailbell-show, which owns how the alert is drawn.

    `kind` is what the renderer picks a sound from, so an older tailbell-show
    that ignores a seventh argument degrades to the previous behaviour instead
    of breaking — which is what a half-updated pair of machines looks like.
    """
    if os.access(SHOW, os.X_OK):
        argv = [SHOW, title, message, "urgent" if urgent else "",
                project or "", app or "", entrypoint or "", kind or ""]
    else:
        argv = ["/usr/bin/osascript", "-e",
                'display notification %s with title %s sound name "Glass"'
                % (json.dumps(message), json.dumps(title))]
    # argv dispatch: the message stays data and can never be parsed as a command.
    try:
        subprocess.run(argv, timeout=15, check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def stream_once(host):
    """Tail one host until the connection ends. True if any event arrived."""
    # universal_newlines, not text=: `text` is 3.7+, and this file must stay
    # runnable on the cluster's 3.6.8 as well as on the Mac. It was not — and the
    # handler in watch() swallowed the TypeError, so the host was silently never
    # streamed while every other check reported green.
    proc = subprocess.Popen(["ssh"] + SSH_OPTS + [host, REMOTE_CMD],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            universal_newlines=True, bufsize=1)
    got = False
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        got = True
        ts = rec.get("ts")
        if isinstance(ts, (int, float)) and time.time() - ts > MAX_AGE_SECONDS:
            # Say so rather than dropping it silently: launchd routes this to
            # /tmp/tailbell.err, which tailbell-doctor prints.
            sys.stderr.write(
                "tailbell-listen: %s: dropped an event %ds old (%s) — the remote "
                "log was probably replaced\n"
                % (host, int(time.time() - ts), rec.get("title", "")))
            sys.stderr.flush()
            continue
        if already_shown(rec):
            continue
        show(rec.get("title") or "Claude Code",
             rec.get("message") or "",
             urgent=(rec.get("priority") == "high"),
             project=rec.get("project") or "",
             app=rec.get("app") or "",
             entrypoint=rec.get("entrypoint") or "",
             kind=rec.get("kind") or "")
    proc.wait()
    return got


def watch(host, stop):
    """One thread per host: reconnect while the master lives, then retire."""
    backoff = 5
    while not stop.is_set():
        if not master_alive(host):
            # The connection is gone; the supervisor will re-add this host if it
            # comes back, so let the thread end rather than poll forever.
            return
        try:
            stream_once(host)
            backoff = 5
        except Exception as exc:
            # Say so. `pass` here once hid a TypeError that stopped every host
            # from being streamed, and the only symptom was silence. launchd
            # sends this to /tmp/tailbell.err, which tailbell-doctor already
            # shows you.
            sys.stderr.write("tailbell-listen: %s: %r\n" % (host, exc))
            sys.stderr.flush()
        if stop.wait(backoff):
            return
        backoff = min(backoff * 2, 60)


_cluster_cache = {}


def cluster_of(host):
    """Which cluster this host belongs to, or None if tailbell is not installed.

    Every login node of a cluster shares one $HOME, so ~/.tailbell/cluster-id is
    identical across them and distinct between clusters. Grouping by it is what
    keeps six connections to Great Lakes from becoming six streams over the same
    file. Cached: the answer cannot change for a given host.
    """
    if host in _cluster_cache:
        return _cluster_cache[host]
    cid = None
    try:
        r = subprocess.run(["ssh"] + SSH_OPTS + [host, "cat ~/.tailbell/cluster-id"],
                           timeout=20, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL)
        out = (r.stdout or b"").decode("utf-8", "replace").strip()
        cid = out or None
    except Exception:
        cid = None
    if cid:
        _cluster_cache[host] = cid
    return cid


def main():
    # cluster id -> (host, thread). One live stream per cluster, never per host.
    streams = {}
    stop = threading.Event()
    while True:
        hosts = discover_hosts()

        # Retire finished streams so their cluster can be picked up again, on
        # whichever node is still connected.
        for cid in [c for c, (_, t) in streams.items() if not t.is_alive()]:
            del streams[cid]

        for host in sorted(hosts):
            if not master_alive(host):
                continue
            cid = cluster_of(host)
            if cid is None:
                continue                      # tailbell not installed there
            if cid in streams:
                continue                      # this cluster already has a stream
            t = threading.Thread(target=watch, args=(host, stop), daemon=True)
            streams[cid] = (host, t)
            t.start()

        time.sleep(RESCAN_SECONDS)


if __name__ == "__main__":
    sys.exit(main())
