#!/usr/bin/env bash
# tailbell-doctor — check every link in the chain and name the one that is broken.
#
# Runs on either side and checks whichever side it is on:
#   agent host   : are the hooks registered? tools present? is the log growing?
#                  and above all, what did the last decisions say?
#   workstation  : is the listener alive? is an SSH master up? can it render?
#
# Usage: tailbell-doctor [--test]     --test also emits a real notification.
set -u

TEST=0; [ "${1:-}" = "--test" ] && TEST=1
TAILBELL_HOME="${TAILBELL_HOME:-$HOME/.tailbell}"
[ -f "$TAILBELL_HOME/config" ] && . "$TAILBELL_HOME/config"
TRANSPORT="${TAILBELL_TRANSPORT:-file}"
LOGFILE="${TAILBELL_LOG:-$TAILBELL_HOME/events.log}"
DEBUG="${TAILBELL_DEBUG_LOG:-$TAILBELL_HOME/debug.log}"
STATE_DIR="${TAILBELL_STATE_DIR:-$TAILBELL_HOME/state}"
SELFDIR="$(cd "$(dirname "$0")" && pwd)"

# Resolved exactly the way tailbell-notify resolves it, so this check cannot
# disagree with what will actually be sent. A doctor that computes the answer a
# second way is a doctor that reports green while the hook does something else —
# that already happened once with the SSH host list.
CHANNELS="${TAILBELL_CHANNELS:-}"
if [ -z "$CHANNELS" ]; then
  if [ "$(uname)" = "Darwin" ]; then CHANNELS="desktop"; else CHANNELS="$TRANSPORT"; fi
fi
CURL="${TAILBELL_CURL:-curl}"

ok=0; bad=0; warn=0
# Counting a file that may not exist yet. Guard before redirecting, so a missing
# file is 0 rather than a shell error nobody asked for.
count_lines() { [ -f "$1" ] && wc -l < "$1" | tr -d ' ' || echo 0; }
pass() { printf '  ✅ %s\n' "$*"; ok=$((ok+1)); }
fail() { printf '  ❌ %s\n' "$*"; bad=$((bad+1)); }
note() { printf '  ⚠️  %s\n' "$*"; warn=$((warn+1)); }
sect() { printf '\n\033[1m%s\033[0m\n' "$*"; }
# Neither good nor bad news — just what is configured. Counting it as a pass
# would let a green tally hide the ❌ two lines below it.
info() { printf '     %s\n' "$*"; }

printf '\033[1mtailbell doctor\033[0m   (%s, %s)\n' "$(uname)" "$(hostname -s 2>/dev/null)"

sect "配置"
if [ -f "$TAILBELL_HOME/config" ]; then pass "config 存在 (transport=$TRANSPORT)"
else note "没有 $TAILBELL_HOME/config,全部走默认值 (transport=$TRANSPORT)"; fi

########################################################################
# Delivery channels
#
# Reported before the platform split because channels are configured on
# whichever side raises the event, and a broken one looks identical from both.
#
# Without --test nothing is sent: the checks are "is it configured", "is the URL
# the shape that provider uses", and "can this machine reach the host at all".
# With --test a real notification goes through every channel and the server's own
# answer is quoted back, which is the only way to tell a revoked webhook from a
# working one.
########################################################################
sect "送达通道"

# A webhook URL IS the credential — anyone holding it can post as you. Keep the
# host and the first path segment, which is all you need to recognise it, and
# throw the rest away. This runs on a shared login node; the output gets pasted
# into issues.
redact() {
  printf '%s' "$1" | /usr/bin/python3 -c '
import sys
try:
    from urllib.parse import urlsplit
except ImportError:
    from urlparse import urlsplit
u = urlsplit(sys.stdin.read().strip())
parts = [p for p in u.path.split("/") if p]
head = "/" + parts[0] if parts else ""
tail = "/…" if len(parts) > 1 else ""
print("%s://%s%s%s" % (u.scheme, u.netloc, head, tail))' 2>/dev/null
}

# Reachability, not correctness: curl exiting 0 means DNS resolved, the proxy (if
# any) let us out and the TLS handshake finished. Any HTTP status counts — a 405
# from a webhook host still proves the path out of this machine works, which is
# the thing that breaks on a compute node with no http_proxy.
reachable() {
  local origin
  origin="$(printf '%s' "$1" | sed -E 's|^(https?://[^/]+).*|\1|')"
  "$CURL" -sS -o /dev/null -m 8 -I "$origin" >/dev/null 2>&1
}

check_channel() {
  local name="$1" url="$2" want="$3" label="$4"
  if [ -z "$url" ]; then
    fail "$name: 没配 $label —— 这条通道不会送出任何东西"
    return
  fi
  info "$name: $(redact "$url")"
  case "$url" in
    $want) ;;
    *) note "$name: 地址不像 $name 的 webhook (通常是 ${want%\*}) —— 自建/代理地址可以忽略这条" ;;
  esac
  if reachable "$url"; then pass "$name: 主机可达"
  else fail "$name: 连不上主机 —— 计算节点要走 http_proxy,登录节点直连,检查 \$http_proxy"; fi
}

if ! command -v "$CURL" >/dev/null 2>&1 && [ ! -x "$CURL" ]; then
  note "curl 不在 PATH 上 —— 只有 file/desktop 通道能用"
fi

printf '  通道清单: %s\n' "$CHANNELS"
for ch in $(printf '%s' "$CHANNELS" | tr ',' ' '); do
  case "$ch" in
    file)
      if [ -w "$(dirname "$LOGFILE")" ]; then pass "file: 可写 $LOGFILE (release 0 的保底路径)"
      else fail "file: $(dirname "$LOGFILE") 不可写"; fi ;;
    desktop)
      if [ "$(uname)" = "Darwin" ]; then pass "desktop: 本机直接渲染"
      else fail "desktop 通道只在 macOS 有意义,这台是 $(uname)"; fi ;;
    ntfy)
      if [ -z "${TAILBELL_NTFY_TOPIC:-}" ]; then
        fail "ntfy: 没配 TAILBELL_NTFY_TOPIC —— 这条通道不会送出任何东西"
      else
        # The topic is the password: anyone who knows it reads your
        # notifications. Say so here, where someone is looking at the config.
        info "ntfy: ${TAILBELL_NTFY_SERVER:-https://ntfy.sh} topic ${TAILBELL_NTFY_TOPIC:0:3}… (topic 就是密码,别外传)"
        [ ${#TAILBELL_NTFY_TOPIC} -lt 16 ] && \
          note "ntfy: topic 只有 ${#TAILBELL_NTFY_TOPIC} 个字符 —— 太短容易被猜到,建议 24 位以上随机串"
        # /v1/health is the one endpoint that answers without publishing.
        if "$CURL" -sS -m 8 "${TAILBELL_NTFY_SERVER:-https://ntfy.sh}/v1/health" 2>/dev/null | grep -q 'true'; then
          pass "ntfy: 服务器健康检查通过"
        else
          fail "ntfy: ${TAILBELL_NTFY_SERVER:-https://ntfy.sh}/v1/health 不通 —— 服务器挂了或这台机器出不去"
        fi
      fi ;;
    slack)   check_channel slack   "${TAILBELL_SLACK_WEBHOOK:-}"   'https://hooks.slack.com/*'                TAILBELL_SLACK_WEBHOOK ;;
    discord) check_channel discord "${TAILBELL_DISCORD_WEBHOOK:-}" 'https://discord*.com/api/webhooks/*'      TAILBELL_DISCORD_WEBHOOK ;;
    feishu)
      check_channel feishu "${TAILBELL_FEISHU_WEBHOOK:-}" 'https://open.*/open-apis/bot/v2/hook/*' TAILBELL_FEISHU_WEBHOOK
      if [ -n "${TAILBELL_FEISHU_WEBHOOK:-}" ]; then
        if [ -n "${TAILBELL_FEISHU_SECRET:-}" ]; then
          # Signed mode without openssl sends nothing at all, so it is a hard
          # fail rather than a note.
          command -v openssl >/dev/null 2>&1 \
            && pass "feishu: 签名模式,openssl 在" \
            || fail "feishu: 配了 TAILBELL_FEISHU_SECRET 但没有 openssl —— 签不了名,一条也发不出去"
        else
          note "feishu: 没配签名 —— 机器人若开了「签名校验」会拒收;开「关键词」模式的话确认标题里有那个词"
        fi
      fi ;;
    '') ;;
    *) fail "不认识的通道名 '$ch' —— 支持的是 desktop file ntfy slack discord feishu" ;;
  esac
done

if [ "$TEST" = 1 ]; then
  sect "通道实测 (真的发一条出去)"
  # Driven through tailbell-notify rather than a parallel implementation here:
  # a doctor that builds its own request tests the doctor, not the hook.
  # TAILBELL_SYNC=1 makes the normally-backgrounded network sinks finish first.
  dbefore=$(count_lines "$DEBUG")
  printf '{"session_id":"doctor00-0000-0000-0000-000000000000","cwd":"%s"}' "$PWD" \
    | TAILBELL_SYNC=1 "$SELFDIR/tailbell-notify" AskUserQuestion
  dafter=$(count_lines "$DEBUG")
  if [ "$dafter" -gt "$dbefore" ]; then
    # Strip debug.log's timestamp and event columns; what matters here is which
    # channel said what.
    sed -n "$((dbefore+1)),${dafter}p" "$DEBUG" \
      | sed -E 's/^[0-9]{2}-[0-9]{2} [0-9:]{8} +[A-Za-z?]+ +//' \
      | while IFS= read -r l; do
      case "$l" in
        EMITTED*) printf '  ✅ %s\n' "$l" ;;
        FAILED*)  printf '  ❌ %s\n' "$l" ;;
        SKIPPED*) printf '  ⚠️  %s\n' "$l" ;;
      esac
    done
    # Counted separately: the loop above runs in a subshell, so ok/bad set there
    # would not survive it. This is the pipe-to-while trap, and it has bitten
    # this file before.
    e=$(sed -n "$((dbefore+1)),${dafter}p" "$DEBUG" | grep -c 'FAILED'); e=${e:-0}
    if [ "$e" -gt 0 ]; then bad=$((bad+e)); else ok=$((ok+1)); fi
  else
    fail "hook 一行日志都没写 —— tailbell-notify 没跑起来"
  fi
fi

if [ "$(uname)" = "Darwin" ]; then
#################################################### workstation ##############
  sect "显示层"
  for f in tailbell-show tailbell-listen; do
    if [ -x "$SELFDIR/$f" ]; then pass "$f 可执行"; else fail "$SELFDIR/$f 缺失或不可执行"; fi
  done
  [ -x /usr/bin/python3 ] && pass "/usr/bin/python3 存在" \
    || fail "/usr/bin/python3 缺失 —— 装 Xcode Command Line Tools: xcode-select --install"
  if pgrep -x Hammerspoon >/dev/null 2>&1; then pass "Hammerspoon 在跑 (居中弹窗可用)"
  else note "Hammerspoon 没跑 —— 走右上角横幅,这是 v0 的保底路径,正常"; fi
  command -v alerter >/dev/null 2>&1 && pass "alerter 可用" \
    || note "alerter 没装 —— 退到 osascript(注意它需要给 Script Editor 授权通知)"

  sect "监听层"
  if launchctl list 2>/dev/null | grep -q 'tailbell'; then pass "LaunchAgent 已加载"
  else fail "LaunchAgent 没加载 —— 跑 mac/install.sh"; fi
  if pgrep -f 'tailbell-listen' >/dev/null 2>&1; then pass "监听进程在跑"
  else fail "tailbell-listen 没在跑 —— 看 /tmp/tailbell.err"; fi

  sect "SSH 通道 (远程事件全靠它)"
  # Discover exactly the way the listener does, from the ControlMaster sockets, so
  # this check cannot disagree with what the listener will actually watch. A
  # hardcoded list here used to say "gl6 没有 master" while the listener was
  # happily streaming from gl-login3.
  anym=0
  for sock in "$HOME"/.ssh/cm-*; do
    [ -S "$sock" ] || [ -e "$sock" ] || continue
    base="${sock##*/}"; rest="${base#cm-}"; hostport="${rest#*@}"
    # The port separator depends on how ControlPath was written: %h-%p gives
    # host-22, %h:%p gives host:22. Stripping only on a hyphen turned
    # armis2.arc-ts.umich.edu:22 into armis2.arc — strip a trailing port
    # regardless of which separator produced it.
    h="$(printf '%s' "$hostport" | sed -E 's/[:-][0-9]+$//')"
    [ -n "$h" ] || continue
    if ssh -O check "$h" >/dev/null 2>&1; then
      pass "$h 有活着的 master (免认证复用)"; anym=1
    else
      note "$h 的 socket 还在但连接已断 (陈旧,可忽略)"
    fi
  done
  [ "$anym" = 0 ] && fail "一个 master 都没有 —— 跑 'ssh <集群别名> true' 建一条 (最常见故障)"

  if [ -s /tmp/tailbell.err ]; then
    note "监听器有错误输出,最后 5 行:"; tail -5 /tmp/tailbell.err | sed 's/^/       /'
  else pass "监听器无错误输出"; fi

  sect "声音"
  if [ "${TAILBELL_SOUND:-1}" = "0" ]; then note "TAILBELL_SOUND=0 —— 所有提示音已关"
  else
    miss=""
    for snd in "${TAILBELL_SOUND_DONE:-Glass}" "${TAILBELL_SOUND_QUESTION:-Ping}" \
               "${TAILBELL_SOUND_PERMISSION:-Sosumi}" "${TAILBELL_SOUND_ERROR:-Basso}" \
               "${TAILBELL_SOUND_IDLE:-Tink}"; do
      [ -f "/System/Library/Sounds/$snd.aiff" ] || miss="$miss $snd"
    done
    if [ -n "$miss" ]; then fail "这些声音文件不存在:$miss —— 看 /System/Library/Sounds 里有什么"
    else pass "五种事件各有各的提示音,文件都在"; fi
  fi
  case "${TAILBELL_VOICE:-0}" in
    0) note "语音播报关着 (默认)。想开:TAILBELL_VOICE=question,permission" ;;
    *) if [ -z "${TAILBELL_VOICE_NAME:-}" ]; then
         note "开了语音但没指定 TAILBELL_VOICE_NAME —— 提示语是中文,系统默认嗓音多半是英文的,念不好。试 Tingting"
       else pass "语音播报:${TAILBELL_VOICE_NAME}"; fi ;;
  esac

  if [ "$TEST" = 1 ]; then
    sect "实测"
    "$SELFDIR/tailbell-show" "🩺 tailbell 自查" "看到这条说明显示层正常" urgent "" "" "" done \
      && pass "已触发 —— 现在看屏幕"

    # "Distinguishable with the screen turned away" is not something a script can
    # assert; it is something you listen to. So play them, spaced out, and let
    # the person decide.
    if [ "${TAILBELL_SOUND:-1}" != "0" ] && [ -x /usr/bin/afplay ]; then
      echo "     现在依次播放三种提示音 —— 把头转开听,应该能分辨:"
      for pair in "完成:${TAILBELL_SOUND_DONE:-Glass}" \
                  "在等你回答:${TAILBELL_SOUND_QUESTION:-Ping}" \
                  "需要授权:${TAILBELL_SOUND_PERMISSION:-Sosumi}"; do
        printf '       %s (%s)\n' "${pair%%:*}" "${pair##*:}"
        /usr/bin/afplay "/System/Library/Sounds/${pair##*:}.aiff" 2>/dev/null
        sleep 1
      done
    fi
  fi

else
#################################################### agent host ###############
  sect "hooks 是否注册"
  # Resolve the interpreter first. A bare `python3` would pick up whatever
  # virtualenv is active, which on this cluster is a per-project .venv.
  PY=/usr/bin/python3
  [ -x "$PY" ] || PY="$(command -v python3 || echo python3)"
  "$PY" - <<'PYEOF'
import json, pathlib
want = {"Stop": None, "UserPromptSubmit": None, "SessionEnd": None,
        "Notification": None, "StopFailure": None, "Elicitation": None,
        "PreToolUse": "AskUserQuestion"}
found = {k: False for k in want}
for p in [pathlib.Path.home()/".claude"/"settings.json",
          pathlib.Path.home()/".claude"/"settings.local.json"]:
    if not p.exists():
        continue
    try:
        hooks = json.loads(p.read_text()).get("hooks", {})
    except Exception:
        continue
    for ev, matcher in want.items():
        for e in hooks.get(ev) or []:
            cmds = " ".join(x.get("command", "") for x in e.get("hooks", []))
            if "tailbell-notify" not in cmds:
                continue
            if matcher and e.get("matcher") != matcher:
                continue
            found[ev] = True
for ev, matcher in want.items():
    label = ev + ((" (matcher=%s)" % matcher) if matcher else "")
    print(("  ✅ " + label) if found[ev]
          else ("  ❌ %s 没指向 tailbell-notify —— 该事件不会通知你" % label))
PYEOF

  sect "依赖工具"
  for t in jq flock hostname stat tee date; do
    command -v "$t" >/dev/null 2>&1 && pass "$t" || fail "$t 缺失 —— hook 会静默失败"
  done

  sect "事件日志"
  if [ -f "$LOGFILE" ]; then
    n=$(count_lines "$LOGFILE")
    pass "events.log: $n 行,最后写入 $(stat -c %y "$LOGFILE" 2>/dev/null | cut -d. -f1)"
    [ "$n" -gt 0 ] && tail -3 "$LOGFILE" | /usr/bin/python3 -c '
import sys, json
for l in sys.stdin:
    l = l.strip()
    if not l: continue
    try: r = json.loads(l)
    except ValueError: continue
    print("       %s | %s" % (r.get("title"), r.get("message")))'
  else note "events.log 还不存在 (从未发出过事件)"; fi

  sect "决策日志 —— 「为什么没通知我」的答案在这里"
  if [ -f "$DEBUG" ]; then
    pass "debug.log 最近 12 行:"
    tail -12 "$DEBUG" | sed 's/^/       /'
    s=$(grep -c 'skipped:' "$DEBUG" 2>/dev/null); s=${s:-0}
    a=$(grep -cE 'ABORT|FAILED' "$DEBUG" 2>/dev/null); a=${a:-0}
    [ "$s" -gt 0 ] && note "有 $s 次因回合过短被跳过 (阈值 ${TAILBELL_MIN_SECONDS:-60}s)"
    [ "$a" -gt 0 ] && fail "有 $a 次 ABORT/FAILED —— 原因见上面日志"
  else note "debug.log 不存在 —— hook 一次都没被调用过"; fi

  sect "会话计时状态"
  c=$(ls -1 "$STATE_DIR"/*.start 2>/dev/null | wc -l)
  echo "     $c 个会话正在计时"

  if [ "$TEST" = 1 ]; then
    sect "实测 (伪造一个跑了 10 分钟的会话)"
    sid="doctor00-0000-0000-0000-000000000000"
    # `wc -l < missing` fails as a *shell* redirection, and the shell prints that
    # error on its own stderr — which `2>/dev/null` inside the command does not
    # cover. On a first run that made a perfectly good test print
    # "No such file or directory" immediately above "写入成功".
    before=$(count_lines "$LOGFILE")
    mkdir -p "$STATE_DIR"; echo $(( $(date +%s) - 600 )) > "$STATE_DIR/$sid.start"
    printf '{"session_id":"%s","cwd":"%s"}' "$sid" "$PWD" \
      | "$SELFDIR/tailbell-notify" Stop
    after=$(count_lines "$LOGFILE")
    if [ "$after" -gt "$before" ]; then
      pass "写入成功: $(tail -1 "$LOGFILE")"
      echo "     → 若工作站上没弹窗,问题在那一侧,去那边再跑一次本脚本"
    else fail "没写进去 —— 看上面的决策日志"; fi
    rm -f "$STATE_DIR/$sid.start"
  fi
fi

sect "结论"
printf '  %d 项正常, %d 项警告, %d 项失败\n' "$ok" "$warn" "$bad"
if   [ "$bad" -gt 0 ]; then echo "  → 先修 ❌"
elif [ "$warn" -gt 0 ]; then echo "  → 无硬故障;⚠️ 可能就是你没收到通知的原因"
else echo "  → 这一侧全绿。两侧都跑一遍才能定位问题在哪一端。"; fi
[ "$TEST" = 0 ] && echo "  (加 --test 会真发一条做端到端验证)"
exit 0
